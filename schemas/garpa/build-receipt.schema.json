{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/build-receipt.schema.json",
  "title": "GARPA Build Receipt",
  "description": "The exact hardware, software, labor, costs, substitutions, and deviations present in an executed build.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "buildId",
    "manifestDigest",
    "architectureDigest",
    "qualificationContractDigest",
    "startedAt",
    "installedHardware",
    "installedSoftware",
    "codeCommits",
    "substitutions",
    "deviations",
    "actualCostLines",
    "actualLabor",
    "artifacts",
    "buildDigest",
    "state"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "buildId": { "type": "string", "minLength": 1 },
    "manifestDigest": { "type": "string", "minLength": 1 },
    "architectureDigest": { "type": "string", "minLength": 1 },
    "qualificationContractDigest": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string" },
    "installedHardware": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifestItemId", "model", "quantity", "functionIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "manifestItemId": { "type": "string", "minLength": 1 },
          "manufacturer": { "type": "string" },
          "model": { "type": "string", "minLength": 1 },
          "revision": { "type": "string" },
          "serialOrLot": { "type": "string" },
          "firmwareVersion": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "functionIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "installedSoftware": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifestItemId", "name", "version", "packageOrImageDigest", "configurationDigest", "functionIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "manifestItemId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "packageOrImageDigest": { "type": "string", "minLength": 1 },
          "configurationDigest": { "type": "string", "minLength": 1 },
          "functionIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "codeCommits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "dirty", "purpose"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "minLength": 1 },
          "dirty": { "type": "boolean" },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "substitutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "originalManifestItemId", "replacementInstalledItemId", "requiredRegressionTestIds", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "originalManifestItemId": { "type": "string", "minLength": 1 },
          "replacementInstalledItemId": { "type": "string", "minLength": 1 },
          "policyRef": { "type": "string" },
          "requiredRegressionTestIds": { "type": "array", "items": { "type": "string" } },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "severity", "affectedFunctionIds", "affectedMetricIds", "closureState", "evidenceArtifactIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["minor", "material", "unsafe"] },
          "affectedFunctionIds": { "type": "array", "items": { "type": "string" } },
          "affectedMetricIds": { "type": "array", "items": { "type": "string" } },
          "closureState": { "enum": ["open", "accepted", "requalified", "closed"] },
          "evidenceArtifactIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "actualCostLines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "description", "amount", "currency", "incurredAt", "evidenceArtifactIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["hardware", "software", "services", "fabrication", "integration_labor", "operator_labor", "test_equipment", "qualification", "maintenance", "spares", "communications", "facilities", "energy", "regulatory", "other"] },
          "description": { "type": "string", "minLength": 1 },
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "type": "string", "minLength": 1 },
          "incurredAt": { "type": "string", "minLength": 1 },
          "evidenceArtifactIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "actualLabor": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "actor", "category", "hours"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "category": { "enum": ["research", "procurement", "assembly", "configuration", "custom_development", "integration", "debugging", "test_preparation", "test_execution", "analysis", "documentation"] },
          "hours": { "type": "number", "exclusiveMinimum": 0 },
          "startedAt": { "type": "string" },
          "endedAt": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "artifacts": { "type": "array" },
    "buildDigest": { "type": "string", "minLength": 1 },
    "state": { "enum": ["in_progress", "assembled", "blocked", "superseded"] }
  }
}
