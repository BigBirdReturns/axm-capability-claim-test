{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/case-registry-entry.schema.json",
  "title": "GARPA Public Case Registry Entry",
  "description": "A durable public identity, version, release, disposition, and lineage record for one GARPA case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "canonicalSubject",
    "aliases",
    "versions",
    "lineage",
    "domainTags",
    "capabilityTags",
    "currentState",
    "releases",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "caseState": {
      "enum": [
        "created",
        "evidence_blocked",
        "goal_admitted",
        "architecture_candidate",
        "qualification_frozen",
        "build_assembled",
        "evaluation_complete",
        "publication_ready",
        "superseded",
        "withdrawn"
      ]
    },
    "disposition": {
      "enum": [
        "acquire",
        "compose",
        "develop",
        "experiment",
        "wait_for_evidence",
        "decline",
        "unresolved"
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionId",
        "label",
        "firstSeenAt",
        "sourceArtifactIds",
        "state"
      ],
      "properties": {
        "versionId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "exactVersion": { "type": "string" },
        "firstSeenAt": { "type": "string", "minLength": 1 },
        "lastSeenAt": { "type": "string" },
        "sourceArtifactIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "state": { "enum": ["current", "superseded", "unknown"] }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fromSubject",
        "toSubject",
        "relation",
        "sourceArtifactIds",
        "note"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fromSubject": { "type": "string", "minLength": 1 },
        "toSubject": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": [
            "same_offering",
            "rebrand",
            "successor",
            "predecessor",
            "acquired_brand",
            "organizational_transfer"
          ]
        },
        "effectiveAt": { "type": "string" },
        "sourceArtifactIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "releaseNumber",
        "manifestDigest",
        "state",
        "createdAt"
      ],
      "properties": {
        "releaseId": { "type": "string", "minLength": 1 },
        "releaseNumber": { "type": "integer", "minimum": 1 },
        "manifestDigest": { "$ref": "#/$defs/sha256" },
        "state": { "enum": ["current", "superseded", "withdrawn"] },
        "priorReleaseDigest": { "$ref": "#/$defs/sha256" },
        "supersedesReleaseId": { "type": "string" },
        "createdAt": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "canonicalSubject": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "claimant": { "type": "string" },
    "organization": { "type": "string" },
    "offering": { "type": "string" },
    "versions": {
      "type": "array",
      "items": { "$ref": "#/$defs/version" }
    },
    "lineage": {
      "type": "array",
      "items": { "$ref": "#/$defs/lineage" }
    },
    "domainTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "capabilityTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "currentState": { "$ref": "#/$defs/caseState" },
    "currentDisposition": { "$ref": "#/$defs/disposition" },
    "releases": {
      "type": "array",
      "items": { "$ref": "#/$defs/release" }
    },
    "currentReleaseId": { "type": "string" },
    "currentReleaseDigest": { "$ref": "#/$defs/sha256" },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 }
  }
}
