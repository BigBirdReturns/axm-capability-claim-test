{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/commons-catalog.schema.json",
  "title": "GARPA Capability Commons Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "revision",
    "createdAt",
    "updatedAt",
    "primitiveEntries",
    "componentObservationEntries",
    "architecturePatternEntries",
    "catalogDigest"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionId",
        "revisionNumber",
        "objectDigest",
        "state",
        "sourceCaseId",
        "sourceReleaseId",
        "sourceReleaseDigest",
        "catalogedAt",
        "value"
      ],
      "properties": {
        "revisionId": { "type": "string", "minLength": 1 },
        "revisionNumber": { "type": "integer", "minimum": 1 },
        "objectDigest": { "$ref": "#/$defs/sha256" },
        "state": { "enum": ["current", "superseded", "withdrawn"] },
        "supersedesRevisionId": { "type": "string", "minLength": 1 },
        "sourceCaseId": { "type": "string", "minLength": 1 },
        "sourceReleaseId": { "type": "string", "minLength": 1 },
        "sourceReleaseDigest": { "$ref": "#/$defs/sha256" },
        "catalogedAt": { "type": "string", "format": "date-time" },
        "value": { "type": "object" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogObjectId",
        "objectType",
        "identityKey",
        "aliases",
        "revisions"
      ],
      "properties": {
        "catalogObjectId": { "type": "string", "minLength": 1 },
        "objectType": {
          "enum": ["primitive", "component_observation", "architecture_pattern"]
        },
        "identityKey": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/revision" }
        },
        "currentRevisionId": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "primitiveEntries": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/entry" },
          { "properties": { "objectType": { "const": "primitive" } } }
        ]
      }
    },
    "componentObservationEntries": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/entry" },
          { "properties": { "objectType": { "const": "component_observation" } } }
        ]
      }
    },
    "architecturePatternEntries": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/entry" },
          { "properties": { "objectType": { "const": "architecture_pattern" } } }
        ]
      }
    },
    "catalogDigest": { "$ref": "#/$defs/sha256" }
  }
}
