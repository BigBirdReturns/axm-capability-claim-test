{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/commons-component-projection-request.schema.json",
  "title": "GARPA Commons Component Projection Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transferRequest",
    "expectedTransferResultDigest",
    "targetClaimPacket",
    "projections",
    "projectedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transferRequest": { "type": "object" },
    "expectedTransferResultDigest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "targetClaimPacket": { "type": "object" },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectionId", "nominationId", "candidate"],
        "properties": {
          "projectionId": { "type": "string", "minLength": 1 },
          "nominationId": { "type": "string", "minLength": 1 },
          "candidate": { "type": "object" }
        }
      }
    },
    "projectedAt": { "type": "string", "minLength": 1 }
  }
}
