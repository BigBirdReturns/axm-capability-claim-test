{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/commons-component-projection-request.schema.json",
  "title": "GARPA Commons Component Projection Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionId",
    "catalog",
    "expectedCatalogDigest",
    "compatibilityAdmissionReceipt",
    "targetComponentId",
    "targetEvidence",
    "economicBoundaryRequired",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectionId": { "type": "string", "minLength": 1 },
    "catalog": { "type": "object" },
    "expectedCatalogDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "compatibilityAdmissionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId", "receiptDigest", "targetCaseId", "targetMissionOutcomeDigest",
        "targetCapabilityGraphDigest", "nominationId", "disposition", "catalogObjectId",
        "revisionId", "objectDigest", "sourceCaseId", "sourceReleaseId",
        "sourceReleaseDigest", "targetFunctionIds", "targetInterfaceIds",
        "targetExecutionClass", "targetIdentityReceiptIds",
        "targetCompatibilityReceiptIds", "targetEnvironmentReceiptIds",
        "targetQualificationReceiptIds"
      ],
      "properties": {
        "receiptId": { "type": "string", "minLength": 1 },
        "receiptDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "targetCaseId": { "type": "string", "minLength": 1 },
        "targetMissionOutcomeDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "targetCapabilityGraphDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "nominationId": { "type": "string", "minLength": 1 },
        "disposition": { "const": "compatibility_admitted" },
        "catalogObjectId": { "type": "string", "minLength": 1 },
        "revisionId": { "type": "string", "minLength": 1 },
        "objectDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "sourceCaseId": { "type": "string", "minLength": 1 },
        "sourceReleaseId": { "type": "string", "minLength": 1 },
        "sourceReleaseDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "targetFunctionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "targetInterfaceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "targetExecutionClass": { "enum": ["E0_analysis_only", "E1_simulation_or_replay", "E2_bench_passive", "E3_controlled_field_inert", "E4_regulated_active", "E5_operational_environment"] },
        "targetIdentityReceiptIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "targetCompatibilityReceiptIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "targetEnvironmentReceiptIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "targetQualificationReceiptIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "targetComponentId": { "type": "string", "minLength": 1 },
    "targetEvidence": { "type": "object" },
    "economicBoundaryRequired": { "type": "boolean" },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
