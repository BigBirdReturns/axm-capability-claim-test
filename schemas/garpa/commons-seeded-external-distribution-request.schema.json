{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/commons-seeded-external-distribution-request.schema.json",
  "title": "GARPA Commons-Seeded External Distribution Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seededPublicRegistryRequest",
    "expectedSeededPublicRegistryResultDigest",
    "distributionObservation",
    "distributionEnvelope",
    "admittedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "seededPublicRegistryRequest": {
      "type": "object"
    },
    "expectedSeededPublicRegistryResultDigest": {
      "$ref": "#/$defs/digest"
    },
    "distributionObservation": {
      "$ref": "#/$defs/observation"
    },
    "distributionEnvelope": {
      "$ref": "#/$defs/envelope"
    },
    "admittedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byteLength"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "sha256",
        "mediaType",
        "uri",
        "role",
        "evidenceControl",
        "capturedAt"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "platform_receipt",
            "retrieval_capture",
            "content_manifest",
            "registry_snapshot",
            "qualification_fixture",
            "other"
          ]
        },
        "evidenceControl": {
          "enum": [
            "claimant_controlled",
            "commercially_related",
            "externally_attributed",
            "independent",
            "local_measured",
            "unknown"
          ]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "distributionId",
        "mode",
        "eventKind",
        "channel",
        "destinationUri",
        "caseId",
        "releaseId",
        "releaseNumber",
        "releaseManifestDigest",
        "releaseBundleDigest",
        "registryEntryDigest",
        "publishedAt",
        "observedAt",
        "externallyAccessible",
        "syntheticFixture",
        "observedFiles",
        "evidenceArtifacts",
        "observationDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "distributionId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "qualification_fixture",
            "observed_external_event"
          ]
        },
        "eventKind": {
          "enum": [
            "release_distribution",
            "registry_publication",
            "release_and_registry_publication"
          ]
        },
        "channel": {
          "enum": [
            "public_web",
            "public_repository_release",
            "public_object_storage",
            "public_registry_export",
            "other"
          ]
        },
        "destinationUri": {
          "type": "string",
          "minLength": 1
        },
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "releaseId": {
          "type": "string",
          "minLength": 1
        },
        "releaseNumber": {
          "const": 1
        },
        "releaseManifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "releaseBundleDigest": {
          "$ref": "#/$defs/digest"
        },
        "registryEntryDigest": {
          "$ref": "#/$defs/digest"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "externallyAccessible": {
          "type": "boolean"
        },
        "syntheticFixture": {
          "type": "boolean"
        },
        "observedFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileRecord"
          }
        },
        "evidenceArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceArtifact"
          }
        },
        "observationDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "distributionReceiptId",
        "caseId",
        "releaseId",
        "releaseNumber",
        "releaseManifestDigest",
        "releaseBundleDigest",
        "registryEntryDigest",
        "seededPublicRegistryResultDigest",
        "distributionObservationDigest",
        "observedFileSetDigest",
        "evidenceArtifactSetDigest",
        "mode",
        "eventKind",
        "evaluatedAt",
        "publicRegistryPublished",
        "publicReleaseOccurred",
        "deploymentAuthorityClaimed",
        "unrestrictedEquivalenceClaimed",
        "envelopeDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "distributionReceiptId": {
          "type": "string",
          "minLength": 1
        },
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "releaseId": {
          "type": "string",
          "minLength": 1
        },
        "releaseNumber": {
          "const": 1
        },
        "releaseManifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "releaseBundleDigest": {
          "$ref": "#/$defs/digest"
        },
        "registryEntryDigest": {
          "$ref": "#/$defs/digest"
        },
        "seededPublicRegistryResultDigest": {
          "$ref": "#/$defs/digest"
        },
        "distributionObservationDigest": {
          "$ref": "#/$defs/digest"
        },
        "observedFileSetDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceArtifactSetDigest": {
          "$ref": "#/$defs/digest"
        },
        "mode": {
          "enum": [
            "qualification_fixture",
            "observed_external_event"
          ]
        },
        "eventKind": {
          "enum": [
            "release_distribution",
            "registry_publication",
            "release_and_registry_publication"
          ]
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "publicRegistryPublished": {
          "type": "boolean"
        },
        "publicReleaseOccurred": {
          "type": "boolean"
        },
        "deploymentAuthorityClaimed": {
          "const": false
        },
        "unrestrictedEquivalenceClaimed": {
          "const": false
        },
        "envelopeDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
