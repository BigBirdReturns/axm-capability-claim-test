{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/commons-seeded-mission-evaluation-request.schema.json",
  "title": "GARPA Commons-Seeded Mission-Evaluation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "testRunRequests",
    "custodiedMissionEvaluationArgs",
    "evaluationEnvelope",
    "admittedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "testRunRequests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "custodiedMissionEvaluationArgs": {
      "type": "array",
      "minItems": 1
    },
    "evaluationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "evaluationId",
        "caseId",
        "qualificationContractDigest",
        "asBuiltReceiptDigest",
        "preflightReceiptDigest",
        "runBindings",
        "evaluatedAt",
        "qualificationTransferred",
        "missionEquivalenceClaimed",
        "envelopeDigest"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "evaluationId": { "type": "string", "minLength": 1 },
        "caseId": { "type": "string", "minLength": 1 },
        "qualificationContractDigest": { "$ref": "#/$defs/digest" },
        "asBuiltReceiptDigest": { "$ref": "#/$defs/digest" },
        "preflightReceiptDigest": { "$ref": "#/$defs/digest" },
        "runBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runId",
              "expectedTestRunResultDigest",
              "expectedTestRunReceiptDigest",
              "scenarioId"
            ],
            "properties": {
              "runId": { "type": "string", "minLength": 1 },
              "expectedTestRunResultDigest": { "$ref": "#/$defs/digest" },
              "expectedTestRunReceiptDigest": { "$ref": "#/$defs/digest" },
              "scenarioId": { "type": "string", "minLength": 1 }
            }
          }
        },
        "evaluatedAt": { "type": "string", "minLength": 1 },
        "qualificationTransferred": { "const": false },
        "missionEquivalenceClaimed": { "const": false },
        "envelopeDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "admittedAt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  }
}
