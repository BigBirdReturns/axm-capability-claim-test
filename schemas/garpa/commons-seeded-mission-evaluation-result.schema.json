{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/commons-seeded-mission-evaluation-result.schema.json",
  "title": "GARPA Commons-Seeded Mission-Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passed",
    "state",
    "custodiedMissionEvaluationResultDigest",
    "evaluationEnvelopeDigest",
    "campaignPreflightReceiptDigest",
    "runSetDigest",
    "admittedTestRunResultDigests",
    "submittedRunIds",
    "retainedRunIds",
    "delegatedRunIds",
    "excludedRunIds",
    "validRunIds",
    "failedMetricIds",
    "abortedRunIds",
    "invalidatedRunIds",
    "incompleteRunIds",
    "scenarioCoverage",
    "metricCoverage",
    "runDispositions",
    "findings",
    "validationErrors",
    "testRunResults",
    "testRunReceipts",
    "ordinaryPreflightReceipts",
    "pullList",
    "prohibitedTransitions"
  ],
  "properties": {
    "passed": { "type": "boolean" },
    "state": {
      "enum": [
        "seeded_mission_evaluation_blocked",
        "seeded_mission_evaluation_incomplete",
        "seeded_mission_evaluation_admitted"
      ]
    },
    "missionState": {
      "enum": [
        "matched",
        "bounded_match",
        "partial",
        "failed",
        "incomparable",
        "unassessed"
      ]
    },
    "missionEvaluationScope": { "type": "object" },
    "custodiedMissionEvaluationResult": { "type": "object" },
    "custodiedMissionEvaluationResultDigest": {
      "$ref": "#/$defs/digestOrEmpty"
    },
    "evaluationEnvelopeDigest": { "$ref": "#/$defs/digestOrEmpty" },
    "campaignPreflightReceiptDigest": { "$ref": "#/$defs/digestOrEmpty" },
    "runSetDigest": { "$ref": "#/$defs/digestOrEmpty" },
    "admittedTestRunResultDigests": { "$ref": "#/$defs/stringArray" },
    "submittedRunIds": { "$ref": "#/$defs/stringArray" },
    "retainedRunIds": { "$ref": "#/$defs/stringArray" },
    "delegatedRunIds": { "$ref": "#/$defs/stringArray" },
    "excludedRunIds": { "$ref": "#/$defs/stringArray" },
    "validRunIds": { "$ref": "#/$defs/stringArray" },
    "failedMetricIds": { "$ref": "#/$defs/stringArray" },
    "abortedRunIds": { "$ref": "#/$defs/stringArray" },
    "invalidatedRunIds": { "$ref": "#/$defs/stringArray" },
    "incompleteRunIds": { "$ref": "#/$defs/stringArray" },
    "scenarioCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenarioId",
          "requiredValidRuns",
          "submittedRunIds",
          "validRunIds",
          "abortedRunIds",
          "invalidatedRunIds",
          "incompleteRunIds",
          "state"
        ]
      }
    },
    "metricCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metricId",
          "criticality",
          "requiredValidRuns",
          "minimumSamplesPerRun",
          "totalValidSamples",
          "validRunIds",
          "passRunIds",
          "failRunIds",
          "inconclusiveRunIds",
          "notMeasuredRunIds",
          "sampleDeficientRunIds",
          "observedThresholdResults",
          "state"
        ]
      }
    },
    "runDispositions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "findings": {
      "type": "array",
      "items": { "type": "object" }
    },
    "validationErrors": { "$ref": "#/$defs/stringArray" },
    "testRunResults": {
      "type": "array",
      "items": { "type": "object" }
    },
    "testRunReceipts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "ordinaryPreflightReceipts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "pullList": { "$ref": "#/$defs/stringArray" },
    "prohibitedTransitions": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "digestOrEmpty": {
      "type": "string",
      "pattern": "^$|^[A-Fa-f0-9]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
