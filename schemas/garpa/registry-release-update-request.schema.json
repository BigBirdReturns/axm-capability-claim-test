{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/registry-release-update-request.schema.json",
  "title": "GARPA Registry Release Update Request",
  "description": "A candidate update that advances the governing release while preserving prior releases, offering versions, aliases, and source-backed identity lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "currentEntry",
    "candidateRelease",
    "releaseVerificationState",
    "identityPatch",
    "candidateCaseState",
    "updatedAt"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "caseState": {
      "enum": [
        "created",
        "evidence_blocked",
        "goal_admitted",
        "architecture_candidate",
        "qualification_frozen",
        "build_assembled",
        "evaluation_complete",
        "publication_ready",
        "superseded",
        "withdrawn"
      ]
    },
    "disposition": {
      "enum": [
        "acquire",
        "compose",
        "develop",
        "experiment",
        "wait_for_evidence",
        "decline",
        "unresolved"
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionId", "label", "firstSeenAt", "sourceArtifactIds", "state"],
      "properties": {
        "versionId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "exactVersion": { "type": "string" },
        "firstSeenAt": { "type": "string", "minLength": 1 },
        "lastSeenAt": { "type": "string" },
        "sourceArtifactIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "state": { "enum": ["current", "superseded", "unknown"] }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromSubject", "toSubject", "relation", "sourceArtifactIds", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fromSubject": { "type": "string", "minLength": 1 },
        "toSubject": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": [
            "same_offering",
            "rebrand",
            "successor",
            "predecessor",
            "acquired_brand",
            "organizational_transfer"
          ]
        },
        "effectiveAt": { "type": "string" },
        "sourceArtifactIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "currentEntry": { "$ref": "case-registry-entry.schema.json" },
    "candidateRelease": { "$ref": "release-manifest.schema.json" },
    "releaseVerificationState": {
      "enum": ["current_valid", "superseded_valid", "withdrawn_valid"]
    },
    "expectedCurrentReleaseId": { "type": "string" },
    "expectedCurrentReleaseDigest": { "$ref": "#/$defs/sha256" },
    "identityPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalSubject",
        "aliasesAdded",
        "versionsAdded",
        "lineageLinksAdded",
        "domainTagsAdded",
        "capabilityTagsAdded"
      ],
      "properties": {
        "canonicalSubject": { "type": "string", "minLength": 1 },
        "aliasesAdded": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "claimant": { "type": "string" },
        "organization": { "type": "string" },
        "offering": { "type": "string" },
        "versionsAdded": {
          "type": "array",
          "items": { "$ref": "#/$defs/version" }
        },
        "lineageLinksAdded": {
          "type": "array",
          "items": { "$ref": "#/$defs/lineage" }
        },
        "domainTagsAdded": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilityTagsAdded": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "candidateCaseState": { "$ref": "#/$defs/caseState" },
    "candidateDisposition": { "$ref": "#/$defs/disposition" },
    "updatedAt": { "type": "string", "minLength": 1 }
  }
}
