{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/stage-receipt.schema.json",
  "title": "GARPA Stage Receipt",
  "description": "Immutable state-transition receipt. File presence alone never advances a case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "caseId",
    "stage",
    "predecessorReceiptIds",
    "inputDigests",
    "action",
    "toolId",
    "toolVersion",
    "outputPaths",
    "outputDigests",
    "state",
    "blockingReasons",
    "nextActions",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["intake", "extraction", "claims", "evidence", "mission_outcome", "capability_graph", "components", "architecture", "qualification", "build", "testing", "evaluation", "publication"] },
    "predecessorReceiptIds": { "type": "array", "items": { "type": "string" } },
    "inputDigests": { "type": "array", "items": { "type": "string" } },
    "action": { "enum": ["extract", "model_generate", "validate", "gate", "retrieve", "render", "manual_review"] },
    "toolId": { "type": "string", "minLength": 1 },
    "toolVersion": { "type": "string", "minLength": 1 },
    "outputPaths": { "type": "array", "items": { "type": "string" } },
    "outputDigests": { "type": "array", "items": { "type": "string" } },
    "state": { "enum": ["admitted", "blocked", "review_required", "failed", "superseded"] },
    "blockingReasons": { "type": "array", "items": { "type": "string" } },
    "nextActions": { "type": "array", "items": { "type": "string" } },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 }
  }
}
