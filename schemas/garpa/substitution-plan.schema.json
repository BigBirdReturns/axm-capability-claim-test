{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/substitution-plan.schema.json",
  "title": "GARPA Substitution Plan",
  "description": "Versioned candidate components, custom code, compatibility edges, function substitutions, and the complete comparison-cost boundary. Passing this schema does not establish compatibility or mission performance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "capabilityGraphDigest", "components", "customCode", "compatibilityEdges", "options", "costBoundary", "exclusions"],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "capturedAt", "evidenceCellIds", "includedCostCategories", "excludedCostCategories"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "minLength": 1 },
        "evidenceCellIds": { "$ref": "#/$defs/stringArray" },
        "includedCostCategories": { "$ref": "#/$defs/stringArray" },
        "excludedCostCategories": { "$ref": "#/$defs/stringArray" }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "capturedAt", "evidenceCellIds"],
      "properties": {
        "state": { "enum": ["in_stock", "limited", "lead_time", "unavailable", "unknown"] },
        "capturedAt": { "type": "string", "minLength": 1 },
        "evidenceCellIds": { "$ref": "#/$defs/stringArray" },
        "note": { "type": "string" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "product", "exactModelOrVersion", "functionIds", "interfaceIds", "maturity", "identityEvidenceCellIds", "performanceEvidenceCellIds", "licenseEvidenceCellIds", "performanceEnvelope", "operatingRequirements", "securityNotes", "integrationRequirements", "limitations", "residuals", "lifecycle"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["commercial_hardware", "open_hardware", "software_package", "open_source_project", "service", "human_role", "custom_code", "custom_fabrication", "test_equipment", "external_dependency"] },
        "manufacturer": { "type": "string" },
        "product": { "type": "string", "minLength": 1 },
        "exactModelOrVersion": { "type": "string", "minLength": 1 },
        "functionIds": { "$ref": "#/$defs/stringArray" },
        "interfaceIds": { "$ref": "#/$defs/stringArray" },
        "maturity": { "enum": ["vendor_claimed", "community_reported", "independently_reported", "bench_reproduced", "field_reproduced", "locally_qualified"] },
        "identityEvidenceCellIds": { "$ref": "#/$defs/stringArray" },
        "performanceEvidenceCellIds": { "$ref": "#/$defs/stringArray" },
        "licenseEvidenceCellIds": { "$ref": "#/$defs/stringArray" },
        "performanceEnvelope": { "type": "object", "additionalProperties": { "type": "string" } },
        "operatingRequirements": { "type": "object", "additionalProperties": { "type": "string" } },
        "license": { "type": "string" },
        "sourceAvailability": { "type": "string" },
        "securityNotes": { "$ref": "#/$defs/stringArray" },
        "price": { "$ref": "#/$defs/price" },
        "availability": { "$ref": "#/$defs/availability" },
        "integrationRequirements": { "$ref": "#/$defs/stringArray" },
        "limitations": { "$ref": "#/$defs/stringArray" },
        "residuals": { "$ref": "#/$defs/stringArray" },
        "lifecycle": { "enum": ["available", "limited", "end_of_life", "unverified", "superseded"] }
      }
    },
    "customCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "functionIds", "interfaceIds", "purpose", "inputs", "outputs", "complexity", "dependencies", "testStrategy", "safetyProperties", "securityProperties", "residuals"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "functionIds": { "$ref": "#/$defs/stringArray" },
        "interfaceIds": { "$ref": "#/$defs/stringArray" },
        "purpose": { "type": "string", "minLength": 1 },
        "inputs": { "$ref": "#/$defs/stringArray" },
        "outputs": { "$ref": "#/$defs/stringArray" },
        "complexity": { "enum": ["small", "bounded", "substantial", "research_grade", "unresolved"] },
        "dependencies": { "$ref": "#/$defs/stringArray" },
        "testStrategy": { "$ref": "#/$defs/stringArray" },
        "safetyProperties": { "$ref": "#/$defs/stringArray" },
        "securityProperties": { "$ref": "#/$defs/stringArray" },
        "residuals": { "$ref": "#/$defs/stringArray" }
      }
    },
    "compatibilityEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interfaceId", "producerComponentIds", "consumerComponentIds", "state", "adapterComponentIds", "customCodeIds", "evidenceCellIds", "limitations", "falsificationTest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "interfaceId": { "type": "string", "minLength": 1 },
        "producerComponentIds": { "$ref": "#/$defs/stringArray" },
        "consumerComponentIds": { "$ref": "#/$defs/stringArray" },
        "state": { "enum": ["confirmed_compatible", "reported_compatible", "adapter_required", "experimental", "incompatible", "unknown"] },
        "adapterComponentIds": { "$ref": "#/$defs/stringArray" },
        "customCodeIds": { "$ref": "#/$defs/stringArray" },
        "evidenceCellIds": { "$ref": "#/$defs/stringArray" },
        "limitations": { "$ref": "#/$defs/stringArray" },
        "falsificationTest": { "type": "string" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "functionId", "componentIds", "customCodeIds", "coverage", "maturity", "composition", "integrationWork", "evidenceCellIds", "residuals", "falsificationTest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "functionId": { "type": "string", "minLength": 1 },
        "componentIds": { "$ref": "#/$defs/stringArray" },
        "customCodeIds": { "$ref": "#/$defs/stringArray" },
        "coverage": { "enum": ["complete_candidate", "partial_candidate", "experimental", "uncovered"] },
        "maturity": { "enum": ["established", "reported", "experimental", "unknown"] },
        "composition": { "type": "string" },
        "integrationWork": { "$ref": "#/$defs/stringArray" },
        "evidenceCellIds": { "$ref": "#/$defs/stringArray" },
        "residuals": { "$ref": "#/$defs/stringArray" },
        "falsificationTest": { "type": "string" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "capabilityGraphDigest": { "type": "string", "minLength": 1 },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "customCode": { "type": "array", "items": { "$ref": "#/$defs/customCode" } },
    "compatibilityEdges": { "type": "array", "items": { "$ref": "#/$defs/compatibilityEdge" } },
    "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
    "costBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "includedCategories", "excludedCategories"],
      "properties": {
        "state": { "enum": ["complete", "partial", "unresolved"] },
        "currency": { "type": "string" },
        "evaluationPeriod": { "type": "string" },
        "includedCategories": { "$ref": "#/$defs/stringArray" },
        "excludedCategories": { "$ref": "#/$defs/stringArray" },
        "note": { "type": "string" }
      }
    },
    "exclusions": { "$ref": "#/$defs/stringArray" }
  }
}
