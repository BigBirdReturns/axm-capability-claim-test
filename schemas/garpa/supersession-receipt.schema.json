{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axm-capability-claim-test/garpa/supersession-receipt.schema.json",
  "title": "GARPA Supersession Receipt",
  "description": "A candidate or issued receipt that preserves the prior release identity and digest while naming the successor release required by accepted counterevidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "caseId",
    "counterevidencePacketId",
    "supersededReleaseId",
    "supersededReleaseDigest",
    "supersededReleaseNumber",
    "candidateSuccessorReleaseId",
    "candidateSuccessorReleaseNumber",
    "changedClaimIds",
    "reason",
    "requiredUpstreamActions",
    "createdAt",
    "state"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "counterevidencePacketId": { "type": "string", "minLength": 1 },
    "supersededReleaseId": { "type": "string", "minLength": 1 },
    "supersededReleaseDigest": { "$ref": "#/$defs/sha256" },
    "supersededReleaseNumber": { "type": "integer", "minimum": 1 },
    "candidateSuccessorReleaseId": { "type": "string", "minLength": 1 },
    "candidateSuccessorReleaseNumber": { "type": "integer", "minimum": 2 },
    "changedClaimIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reason": { "type": "string", "minLength": 1 },
    "requiredUpstreamActions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "createdAt": { "type": "string", "minLength": 1 },
    "state": { "enum": ["candidate", "issued"] }
  }
}
